"""
robertson_euler_limits.py — Problem Pack ③ (Robertson): where explicit Euler
fails, and how non-negativity behaves.

Covers two report requirements:
    * "Show where explicit Euler becomes unstable, inaccurate, or negative.
       Compare implicit Euler at matched error; 'it did not blow up' is not an
       accuracy claim."
    * "Track conservation y1+y2+y3 = 1, componentwise non-negativity, and
       full-state error as separate diagnostics."

Three separate criteria are reported independently:
    stable   : the run stays finite and bounded
    positive : no component ever goes below -1e-10
    accurate : ||y_h(40) - y_ref(40)||_inf <= ACC_TOL

Run:  python robertson_euler_limits.py
Outputs: robertson_euler_limits.png, robertson_nonnegativity.png
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

Y0 = np.array([1.0, 0.0, 0.0])
T_END = 40.0
ACC_TOL = 1e-2          # accuracy criterion, stated explicitly
NEG_TOL = -1e-10        # tolerance for calling a component "non-negative"
BLOWUP = 1e12           # abort threshold for an obviously diverging run

H_LIST = [2e-2, 1e-2, 5e-3, 2e-3, 1e-3, 6e-4, 5e-4, 4e-4, 3e-4, 2e-4, 1e-4]

# theoretical frozen-Jacobian bound quoted in the problem pack
H_THEORY = 5.9e-4


def robertson_rhs(t, y):
    y1, y2, y3 = y
    return np.array([
        -0.04 * y1 + 1e4 * y2 * y3,
        0.04 * y1 - 1e4 * y2 * y3 - 3e7 * y2 * y2,
        3e7 * y2 * y2,
    ])


def robertson_jacobian(t, y):
    y1, y2, y3 = y
    return np.array([
        [-0.04, 1e4 * y3, 1e4 * y2],
        [0.04, -1e4 * y3 - 6e7 * y2, -1e4 * y2],
        [0.0, 6e7 * y2, 0.0],
    ])


# --------------------------------------------------------------------------
# explicit Euler
# --------------------------------------------------------------------------

def euler_run(h, keep=False):
    """Explicit Euler to T_END. Returns dict with metrics (+ arrays if keep)."""
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    miny = np.inf
    ts, ys = ([0.0], [Y0.copy()]) if keep else (None, None)
    for _ in range(n):
        step = min(h, T_END - t)
        with np.errstate(over="ignore", invalid="ignore"):
            y = y + step * robertson_rhs(t, y)
        if (not np.all(np.isfinite(y))) or np.max(np.abs(y)) > BLOWUP:
            return {"stable": False, "miny": miny, "y": None,
                    "t": np.array(ts) if ts else None,
                    "traj": np.array(ys) if ys else None}
        t += step
        miny = min(miny, float(np.min(y)))
        if keep:
            ts.append(t); ys.append(y.copy())
    return {"stable": True, "miny": miny, "y": y, "t": ts,
            "traj": np.array(ys) if keep else None}


# --------------------------------------------------------------------------
# implicit Euler with Newton (scaffold-consistent)
# --------------------------------------------------------------------------

def newton_solve(t_next, y_n, h, tol=1e-12, max_iter=30):
    w = y_n.copy()
    for k in range(max_iter):
        F = w - y_n - h * robertson_rhs(t_next, w)
        if np.linalg.norm(F, np.inf) < tol:
            return w, k, True
        JF = np.eye(3) - h * robertson_jacobian(t_next, w)
        w = w - np.linalg.solve(JF, F)
    return w, max_iter, False


def implicit_run(h, tol=1e-12):
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    miny = np.inf
    defect = 0.0
    total_iters = 0
    for _ in range(n):
        step = min(h, T_END - t)
        y, its, ok = newton_solve(t + step, y, step, tol=tol)
        total_iters += its
        if not ok:
            return {"ok": False, "miny": miny, "defect": defect, "iters": total_iters}
        t += step
        miny = min(miny, float(np.min(y)))
        defect = max(defect, abs(float(np.sum(y)) - 1.0))
    return {"ok": True, "miny": miny, "defect": defect, "iters": total_iters, "y": y}


def main():
    print("=" * 72)
    print("robertson_euler_limits.py - explicit Euler failure boundaries")
    print(f"criteria: bounded | min(y) >= {NEG_TOL:g} | ||err(40)||_inf <= {ACC_TOL:g}")
    print("=" * 72)

    ref = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                    rtol=1e-12, atol=1e-14)
    y_ref = ref.y[:, -1]
    print(f"reference (Radau rtol=1e-12) y(40) = {y_ref}")

    # ---------------- sweep ------------------------------------------
    print(f"\n  {'h':>9} {'stable':>7} {'non-neg':>8} {'accurate':>9} "
          f"{'min y':>11} {'||err(40)||inf':>15}")
    print("  " + "-" * 66)
    rows = []
    for h in H_LIST:
        r = euler_run(h)
        if r["stable"]:
            err = float(np.max(np.abs(r["y"] - y_ref)))
            nonneg = r["miny"] >= NEG_TOL
            acc = err <= ACC_TOL
        else:
            err = np.nan
            nonneg = r["miny"] >= NEG_TOL
            acc = False
        rows.append((h, r["stable"], nonneg, acc, r["miny"], err))
        print(f"  {h:>9.1e} {str(r['stable']):>7} {str(nonneg):>8} {str(acc):>9} "
              f"{r['miny']:>11.3e} {err:>15.3e}")

    def largest(idx):
        vals = [r[0] for r in rows if r[idx]]
        return max(vals) if vals else None

    h_stab = largest(1)
    h_pos = largest(2)
    h_acc = largest(3)
    print("\n  findings")
    print(f"    largest stable h        : {h_stab:.1e}")
    print(f"    largest non-negative h  : {h_pos if h_pos else float('nan'):.1e}")
    print(f"    largest accurate h      : {h_acc if h_acc else float('nan'):.1e}")
    print(f"    pack frozen-Jacobian    : h < {H_THEORY:.1e}  "
          f"-> empirical stability boundary matches within a factor "
          f"{h_stab/H_THEORY:.2f}" if h_stab else "    (no stable h found)")

    # ---------------- matched-error comparison ------------------------
    if h_acc is None:
        print("\n  no accurate explicit-Euler run on this grid; widen the grid")
        target = None
    else:
        target = next(r[5] for r in rows if r[0] == h_acc)
    print(f"\n  matched-error comparison (target error = {target:.2e})")
    print(f"  {'method':<10} {'h':>9} {'err(40)':>12} {'steps':>9} "
          f"{'Newton iters':>13} {'RHS evals':>11}")
    print("  " + "-" * 70)
    if target is not None:
        steps_e = int(np.ceil(T_END / h_acc))
        print(f"  {'explicit':<10} {h_acc:>9.1e} {target:>12.2e} {steps_e:>9} "
              f"{0:>13} {steps_e:>11}")
        best = None
