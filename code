"""
robertson_stiffness.py — Problem Pack ③ (Robertson): Jacobian eigenvalues and
the stiffness ratio along a tight-tolerance reference trajectory.

Covers the report requirement:
    "Plot both nonzero Jacobian eigenvalues and the defined stiffness ratio
     against logarithmic time. Explain the structural zero eigenvalue and the
     treatment of the initial degeneracy."

Method notes
------------
* The full 3x3 Jacobian always has exactly one zero eigenvalue, because the
  mass-conservation invariant makes (1,1,1) a left null vector. Including that
  eigenvalue makes the stiffness ratio infinite/undefined, so it is excluded
  with an explicit numerical threshold (ZERO_REL).
* Cross-check: eliminate y3 = 1 - y1 - y2 and use the 2x2 reduced Jacobian.
* The plot starts at the first positive logarithmic time: the ratio is not
  informative at the exactly degenerate initial state.

Run:  python robertson_stiffness.py
Output: robertson_stiffness.png
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

Y0 = np.array([1.0, 0.0, 0.0])
T_END = 40.0
# eigenvalues below this relative size are classified as the structural zero
ZERO_REL = 1e-9
# check values quoted in the problem pack (for orientation only)
CHECK_T = [1e-4, 1e-2, 40.0]
CHECK_S = [3.0e3, 5.4e3, 1.58e5]


def robertson_rhs(t, y):
    y1, y2, y3 = y
    return np.array([
        -0.04 * y1 + 1e4 * y2 * y3,
        0.04 * y1 - 1e4 * y2 * y3 - 3e7 * y2 * y2,
        3e7 * y2 * y2,
    ])


def robertson_jacobian(t, y):
    y1, y2, y3 = y
    return np.array([
        [-0.04, 1e4 * y3, 1e4 * y2],
        [0.04, -1e4 * y3 - 6e7 * y2, -1e4 * y2],
        [0.0, 6e7 * y2, 0.0],
    ])


def reduced_jacobian(y):
    """2x2 Jacobian of the reduced system (y3 = 1 - y1 - y2 eliminated)."""
    y1, y2 = y[0], y[1]
    y3 = 1.0 - y1 - y2
    return np.array([
        [-0.04 - 1e4 * y2, 1e4 * (y3 - y2)],
        [0.04 + 1e4 * y2, -1e4 * (y3 - y2) - 6e7 * y2],
    ])


def split_eigenvalues(J):
    """Return (nonzero, zero) eigenvalues of J using a stated relative threshold."""
    e = np.linalg.eigvals(J)
    scale = np.max(np.abs(e))
    if scale == 0.0:
        return e, np.array([], dtype=complex)
    mask = np.abs(e) > ZERO_REL * scale
    return e[mask], e[~mask]


def reference_solution():
    """Tight reference with tolerance and independent-method checks."""
    tight = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                      rtol=1e-12, atol=1e-14, dense_output=True)
    baseline = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                         rtol=1e-10, atol=1e-12, dense_output=True)
    bdf = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="BDF",
                    rtol=1e-12, atol=1e-14)
    probe = np.logspace(-8, np.log10(T_END), 500)
    diff = np.max(np.abs(tight.sol(probe) - baseline.sol(probe)))
    method_diff = np.max(np.abs(tight.y[:, -1] - bdf.y[:, -1]))
    ok = tight.success and baseline.success and bdf.success and diff < 1e-8
    print(f"[0] reference tolerance check (100x): max|tight - baseline| = {diff:.2e}  "
          f"-> {'PASS' if ok else 'FAIL'}")
    print(f"    independent-method check: max|Radau - BDF| at t=40 = "
          f"{method_diff:.2e}")
    return tight, diff


def main():
    print("=" * 68)
    print("robertson_stiffness.py - nonzero eigenvalues and stiffness ratio")
    print("=" * 68)

    ref, _ = reference_solution()

    t = np.logspace(-8, np.log10(T_END), 500)
    Y = ref.sol(t)

    lam1, lam2, ratio = [], [], []
    red1, red2 = [], []
    for ti, yi in zip(t, Y.T):
        nz, zero = split_eigenvalues(robertson_jacobian(ti, yi))
        re = np.sort(np.abs(nz.real))[::-1]          # descending |Re lambda|
        lam1.append(re[0])
        lam2.append(re[1] if len(re) > 1 else np.nan)
        ratio.append(re[0] / re[1] if len(re) > 1 and re[1] > 0 else np.nan)
        rr = np.sort(np.abs(np.linalg.eigvals(reduced_jacobian(yi)).real))[::-1]
        red1.append(rr[0])
        red2.append(rr[1])

    lam1 = np.array(lam1); lam2 = np.array(lam2); ratio = np.array(ratio)
    red1 = np.array(red1); red2 = np.array(red2)

    # ---- check values ------------------------------------------------
    print("\n  t        |Re lambda|max    |Re lambda|min    S(t)        S (pack)")
    print("  " + "-" * 64)
    for tc, sc in zip(CHECK_T, CHECK_S):
        i = int(np.argmin(np.abs(t - tc)))
        print(f"  {tc:<8g} {lam1[i]:<18.3e} {lam2[i]:<18.3e} {ratio[i]:<11.3e} {sc:.2e}")
    i40 = int(np.argmin(np.abs(t - T_END)))
    print(f"\n  |Re lambda|max at t=40 : {lam1[i40]:.3e}   (pack: ~3.39e3)")
    print(f"  explicit-Euler bound   : h < 2/{lam1[i40]:.3e} = "
          f"{2.0/lam1[i40]:.2e}   (pack: ~5.9e-4)")
    print(f"  reduced 2x2 agreement  : max rel. diff = "
          f"{np.nanmax(np.abs(red1 - lam1) / lam1):.2e}")

    # ---- figure ------------------------------------------------------
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4.8))

    ax1.loglog(t, lam1, "-", color="tab:red", lw=2, label=r"$|\mathrm{Re}\,\lambda|_{\max}$ (full 3x3)")
    ax1.loglog(t, lam2, "-", color="tab:blue", lw=2, label=r"$|\mathrm{Re}\,\lambda|_{\min}$ (nonzero)")
    ax1.loglog(t, red1, "--", color="k", lw=1, alpha=0.7, label="reduced 2x2 (max / min)")
    ax1.loglog(t, red2, "--", color="k", lw=1, alpha=0.7)
    ax1.axhline(3.39e3, color="gray", ls=":", lw=1.2)
    ax1.annotate("pack check value ~3.39e3 at t=40",
                 xy=(t[-1], 3.39e3), xytext=(1e-5, 1.2e4),
                 arrowprops=dict(arrowstyle="->", color="gray"), color="gray", fontsize=9)
    ax1.set_xlabel("time t (log scale)")
    ax1.set_ylabel(r"$|\mathrm{Re}\,\lambda|$")
    ax1.set_title("Nonzero Jacobian eigenvalues\n(structural zero eigenvalue excluded)")
    ax1.grid(True, which="both", ls=":", alpha=0.5)
    ax1.legend(fontsize=9, loc="lower right")

    ax2.loglog(t, ratio, "-", color="tab:purple", lw=2, label=r"$S(t)=\max|\mathrm{Re}\lambda|/\min|\mathrm{Re}\lambda|$")
    ax2.loglog(CHECK_T, CHECK_S, "x", color="k", ms=9, mew=2, label="problem-pack check values")
    for tc, sc in zip(CHECK_T, CHECK_S):
        ax2.annotate(f"{sc:.1e}", xy=(tc, sc), xytext=(tc * 1.3, sc * 1.6), fontsize=9)
    ax2.set_xlabel("time t (log scale)")
    ax2.set_ylabel(r"stiffness ratio $S(t)$")
    ax2.set_title("Stiffness ratio from the two nonzero eigenvalues\n(starts at the first positive log time - initial state is degenerate)")
    ax2.grid(True, which="both", ls=":", alpha=0.5)
    ax2.legend(fontsize=9, loc="lower right")

    fig.suptitle("Robertson problem: eigenanalysis along a tight-tolerance reference (Radau, rtol=1e-12)", fontsize=12)
    fig.tight_layout()
    fig.savefig("robertson_stiffness.png", dpi=150)
    plt.close(fig)
    print("\nFigure written: robertson_stiffness.png")
    print("=" * 68)


