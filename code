            err = float(np.max(np.abs(r["y"] - y_ref)))
            steps_i = int(np.ceil(T_END / h))
            # one RHS evaluation per Newton iteration, plus the final
            # convergence check of every step
            rhs_i = r["iters"] + steps_i
            if best is None and err <= target:
                best = (h, err, r, steps_i, rhs_i)
            print(f"  {'implicit':<10} {h:>9.1e} {err:>12.2e} "
                  f"{steps_i:>9} {r['iters']:>13} {rhs_i:>11}")
        if best:
            h_i, err_i, r_i, si, rhs_i = best
            se = int(np.ceil(T_END / h_acc))
            print(f"\n    cheapest implicit run meeting the target: h = {h_i:g} "
                  f"(err {err_i:.2e}, better than the explicit target)")
            print(f"    steps:          explicit {se:,} vs implicit {si:,}"
                  f"  ->  {se/si:,.0f}x fewer steps")
            print(f"    RHS evaluations: explicit {se:,} vs implicit {rhs_i:,}"
                  f"  ->  {se/rhs_i:,.0f}x fewer RHS evaluations")
            print(f"    (implicit pays a 3x3 linear solve per iteration; still "
                  f"far cheaper here)")

    # ---------------- figures ----------------------------------------
    fig, ax = plt.subplots(figsize=(8.5, 5))
    hs = np.array([r[0] for r in rows if r[1]])
    es = np.array([r[5] for r in rows if r[1]])
    ax.loglog(hs, es, "o-", color="tab:red", label="explicit Euler, ||err(40)||inf")
    unstable = [(r[0], r[5]) for r in rows if not r[1]]
    for h, _ in unstable:
        ax.axvline(h, color="tab:gray", ls="--", lw=0.8, alpha=0.5)
    ax.axhline(ACC_TOL, color="tab:green", ls=":", lw=1.5,
               label=f"accuracy tolerance = {ACC_TOL:g}")
    ax.axvline(H_THEORY, color="tab:blue", ls="-.", lw=1.5,
               label=f"frozen-Jacobian bound h<{H_THEORY:.1e}")
    if h_pos:
        ax.axvline(h_pos, color="tab:orange", ls=":", lw=1.5,
                   label=f"positivity limit h={h_pos:.1e}")
    ax.axvspan(max(hs) * 1.05, max(hs) * 3, color="tab:gray", alpha=0.15)
    ax.annotate("unstable\n(no finite solution)", xy=(H_LIST[0] * 1.2, 1e0),
                fontsize=9, color="dimgray")
    ax.set_xlabel("step size h")
    ax.set_ylabel("global error at T=40")
    ax.set_title("Robertson: three separate failure criteria for explicit Euler\n"
                 "(stability, positivity and accuracy are different questions)")
    ax.grid(True, which="both", ls=":", alpha=0.5)
    ax.legend(fontsize=9)
    fig.tight_layout()
    fig.savefig("robertson_euler_limits.png", dpi=150)
    plt.close(fig)

    # non-negativity diagnostics
    fig2, axes = plt.subplots(1, 2, figsize=(13, 4.6))
