"""
robertson_y2_tolerance.py — Problem Pack ③ (Robertson): y2 at several
tolerances, plus a Newton stopping-tolerance sweep.

Covers two requirements:
    * "The final value of y2 reported by your implicit method at several
       tolerances, cross-checked against your own high-accuracy reference."
    * Sanity check: an inexact nonlinear solve produces an invariant defect
       controlled by the nonlinear residual; choose the Newton stopping
       tolerance small enough that algebraic error is negligible relative to
       the time-discretisation error, then demonstrate it with a sweep.

Three error sources are separated explicitly:
    time discretisation (grows with h, ~ O(h) for implicit Euler)
    algebraic / Newton   (controlled by the stopping tolerance)
    reference            (Radau at rtol=1e-12, verified by a 100x
                          tolerance-tightening repeat)

Run:  python robertson_y2_tolerance.py
Outputs: robertson_y2_tolerance.png, robertson_algebraic_error.png
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

Y0 = np.array([1.0, 0.0, 0.0])
T_END = 40.0
H_LIST = [0.4, 0.2, 0.1, 0.05]
NEWTON_TOLS = [1e-2, 1e-4, 1e-6, 1e-8, 1e-10, 1e-12, 1e-14]


def robertson_rhs(t, y):
    y1, y2, y3 = y
    return np.array([
        -0.04 * y1 + 1e4 * y2 * y3,
        0.04 * y1 - 1e4 * y2 * y3 - 3e7 * y2 * y2,
        3e7 * y2 * y2,
    ])


def robertson_jacobian(t, y):
    y1, y2, y3 = y
    return np.array([
        [-0.04, 1e4 * y3, 1e4 * y2],
        [0.04, -1e4 * y3 - 6e7 * y2, -1e4 * y2],
        [0.0, 6e7 * y2, 0.0],
    ])


def newton_solve(t_next, y_n, h, tol):
    """Implicit-Euler step; returns (y_next, iterations, converged)."""
    w = y_n.copy()
    for k in range(60):
        F = w - y_n - h * robertson_rhs(t_next, w)
        if np.linalg.norm(F, np.inf) < tol:
            return w, k, True
        JF = np.eye(3) - h * robertson_jacobian(t_next, w)
        w = w - np.linalg.solve(JF, F)
    return w, 60, False


def implicit_run(h, newton_tol):
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    defect = 0.0          # max |sum(y) - 1|  (invariant defect)
    max_iter = 0
    total_iter = 0
    for _ in range(n):
        step = min(h, T_END - t)
        y, its, ok = newton_solve(t + step, y, step, newton_tol)
        max_iter = max(max_iter, its)
        total_iter += its
        if not ok:
            return None
        t += step
        defect = max(defect, abs(float(np.sum(y)) - 1.0))
    return {"y": y, "defect": defect, "max_iter": max_iter,
            "total_iter": total_iter, "steps": n}


def reference_solution():
    baseline = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                         rtol=1e-10, atol=1e-12)
    tight = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                      rtol=1e-12, atol=1e-14)
    diff = float(np.max(np.abs(baseline.y[:, -1] - tight.y[:, -1])))
    print(f"[0] reference check: Radau(1e-10) vs Radau(1e-12), 100x tighter: "
          f"max component difference = {diff:.2e}")
    print(f"    reference y(40) = {tight.y[:, -1]}   "
          f"(pack orientation: 0.7158271, 9.1855e-6, 0.2841637)")
    return tight.y[:, -1], diff


def main():
    print("=" * 74)
    print("robertson_y2_tolerance.py - y2(40) toward the reference, and the")
    print("                           Newton stopping-tolerance sweep")
    print("=" * 74)

    y_ref, ref_diff = reference_solution()
    digits = -int(np.floor(np.log10(max(ref_diff, 1e-16)))) - 1
    print(f"    -> digits stable under that repeat: about {max(digits,0)} decimals")

    # ---------------- table: y2(40) vs (h, Newton tol) ----------------
    print(f"\n  y2(40) for each (h, Newton stopping tolerance)")
    print(f"  {'h':>6} " + "".join(f"{t:>13.0e}" for t in NEWTON_TOLS))
    print("  " + "-" * (7 + 13 * len(NEWTON_TOLS)))
    results = {}
    for h in H_LIST:
        cells = []
        for tol in NEWTON_TOLS:
            r = implicit_run(h, tol)
            results[(h, tol)] = r
            if r is None:
                cells.append("   diverged   ")
            elif r["total_iter"] == 0:
                # Newton stopped before taking a single update: the returned
                # state is still y_n, so the run is meaningless
                cells.append("   stalled    ")
            else:
                cells.append(f"{r['y'][1]:>13.6e}")
        print(f"  {h:>6.2f} " + "".join(cells))
    print(f"  {'ref':>6}    " + f"{y_ref[1]:>13.6e}   (tight-tolerance reference)")

    # ---------------- algebraic vs time error -------------------------
    print(f"\n  error decomposition at h = 0.1")
    print(f"  {'Newton tol':>12} {'total iters':>12} {'max/step':>9} "
          f"{'defect max|sum-1|':>19} {'||err(40)||inf':>16} {'y2(40)':>14}")
    print("  " + "-" * 88)
    for tol in NEWTON_TOLS:
        r = results[(0.1, tol)]
        if r is None:
            print(f"  {tol:>12.0e} {'-':>12} {'-':>9} {'-':>19} {'diverged':>16} {'-':>14}")
            continue
        err = float(np.max(np.abs(r["y"] - y_ref)))
        flag = "  <- stalled: no Newton update taken" if r["total_iter"] == 0 else ""
        print(f"  {tol:>12.0e} {r['total_iter']:>12} {r['max_iter']:>9} "
              f"{r['defect']:>19.2e} {err:>16.3e} {r['y'][1]:>14.6e}{flag}")

    # ---------------- figure 1: convergence of y2 ---------------------
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4.8))
    tol_tight = 1e-12
    hs, errs, y2s = [], [], []
    for h in H_LIST:
        r = results[(h, tol_tight)]
        if r is None:
            continue
        hs.append(h); errs.append(float(np.max(np.abs(r["y"] - y_ref)))); y2s.append(r["y"][1])
    hs = np.array(hs); errs = np.array(errs)
    ax1.loglog(hs, errs, "o-", color="tab:red", label="implicit Euler, ||err(40)||inf")
    slope = np.polyfit(np.log(hs), np.log(errs), 1)[0]
    c = errs[0] / hs[0]
    hl = np.logspace(np.log10(hs.min()), np.log10(hs.max()), 40)
    ax1.loglog(hl, c * hl, "k--", lw=1.2, label=f"order-1 reference (fit slope {slope:.2f})")
    ax1.set_xlabel("step size h"); ax1.set_ylabel("global error at T=40")
    ax1.set_title("Implicit Euler converges at first order\n(Newton tolerance fixed at 1e-12)")
    ax1.grid(True, which="both", ls=":", alpha=0.5); ax1.legend(fontsize=9)

    ax2.semilogx(hs, y2s, "o-", color="tab:blue", label="y2(40), implicit Euler")
    ax2.axhline(y_ref[1], color="k", ls="--", lw=1.2,
                label=f"reference y2(40) = {y_ref[1]:.6e}")
    ax2.set_xlabel("step size h"); ax2.set_ylabel("y2(40)")
    ax2.set_title("The small component y2(40) approaches the reference\n(asymptotically from above)")
    ax2.grid(True, which="both", ls=":", alpha=0.5); ax2.legend(fontsize=9)
    fig.suptitle("Robertson: y2(40) at several step sizes, cross-checked against a tight reference", fontsize=12)
    fig.tight_layout(); fig.savefig("robertson_y2_tolerance.png", dpi=150); plt.close(fig)

    # ---------------- figure 2: Newton tolerance sweep ----------------
    fig2, (bx1, bx2) = plt.subplots(1, 2, figsize=(13, 4.8))
    for h, mk in zip(H_LIST, ["o", "s", "^", "d"]):
        xs, ds, es = [], [], []
        for tol in NEWTON_TOLS:
            r = results[(h, tol)]
            if r is None:
                continue
            xs.append(tol); ds.append(max(r["defect"], 1e-18))
            es.append(max(float(np.max(np.abs(r["y"] - y_ref))), 1e-18))
        bx1.loglog(xs, ds, mk + "-", label=f"h = {h:g}")
        bx2.loglog(xs, es, mk + "-", label=f"h = {h:g}")
    bx1.set_xlabel("Newton stopping tolerance  ||F||inf < tol")
    bx1.set_ylabel("max invariant defect |sum(y) - 1|")
    bx1.set_title("Algebraic error is controlled by the Newton tolerance\n(machine-level once tol is small enough)")
    bx1.grid(True, which="both", ls=":", alpha=0.5); bx1.legend(fontsize=9)
    bx2.set_xlabel("Newton stopping tolerance")
    bx2.set_ylabel("total error at T=40")
    bx2.set_title("Choose tol so algebraic error is negligible\nvs the time-discretisation error")
    bx2.grid(True, which="both", ls=":", alpha=0.5); bx2.legend(fontsize=9)
    fig2.suptitle("Robertson: Newton stopping tolerance - how small is small enough?", fontsize=12)
    fig2.tight_layout(); fig2.savefig("robertson_algebraic_error.png", dpi=150); plt.close(fig2)

    # ---------------- verdict -----------------------------------------
    r_tight = results[(0.1, 1e-12)]
    r_loose = results[(0.1, 1e-2)]
    print("\n  verdict")
    if r_tight:
        print(f"    h=0.1, tol=1e-12: defect {r_tight['defect']:.2e}, "
              f"{r_tight['total_iter']} Newton iterations total, "
              f"max {r_tight['max_iter']} per step")
    if r_loose:
        err_loose = float(np.max(np.abs(r_loose["y"] - y_ref)))
        print(f"    h=0.1, tol=1e-2 : defect {r_loose['defect']:.2e} "
              f"(looks perfect!) but {r_loose['total_iter']} Newton iterations "
              f"and error {err_loose:.2e}")
        print("      -> a loose tolerance lets Newton stop before taking a single")
        print("         update, so the state never advances. The invariant defect is")
        print("         then exactly zero while the answer is completely wrong:")
        print("         conservation is a WEAK diagnostic (problem pack wording).")
    print("    recommendation: stop Newton at ||F||inf <= 1e-10 or tighter, where the")
    print("    defect reaches machine level and y2(40) stops changing with tol;")
    print("    the remaining error is then purely the time-discretisation error.")
    print("\nFigures written: robertson_y2_tolerance.png, robertson_algebraic_error.png")
    print("=" * 74)


if __name__ == "__main__":
    main()
