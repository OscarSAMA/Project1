"""
failure_case_vanderpol.py — "Failure case" generator for Week 2 Lecture.

Demonstrates the catastrophic failure of explicit Euler on the Van der Pol
oscillator, motivating implicit / stiff-aware methods.

    y1' = y2
    y2' = mu * (1 - y1^2) * y2 - y1

For mu = 10 the system is mildly stiff in the relaxation phase. Explicit Euler
requires h ~ 1/(3 mu) in the stiff phase, far below what accuracy alone would
need; a modest h that looks "small enough" still blows up.

Run with:
    python failure_case_vanderpol.py

Outputs:
    vanderpol_euler_blowup.png      — one large-h Euler run vs a reference
    vanderpol_h_sweep.png           — final-time error vs h, log-log

Authors: Sirui Li, Yuxuan Li, Yuran Zhou, Yazhi Xue
"""

import numpy as np
import matplotlib.pyplot as plt


def vanderpol_rhs(t, y, mu=10.0):
    y1, y2 = y
    return np.array([y2, mu * (1.0 - y1 ** 2) * y2 - y1])


def euler_step(f, t, y, h):
    return y + h * f(t, y)


def solve_euler(f, y0, t0, t1, h):
    """Use nominal step h and shorten only the final step to land exactly at t1."""
    n_steps = int(np.ceil((t1 - t0) / h))
    t = np.empty(n_steps + 1)
    t[0] = t0
    y = np.zeros((n_steps + 1,) + np.shape(y0))
    y[0] = y0
    for n in range(n_steps):
        step = min(h, t1 - t[n])
        t[n + 1] = t[n] + step
        y[n + 1] = euler_step(f, t[n], y[n], step)
    return t, y


def reference_solution(y0, t0, t1):
    """Stiff-aware reference, independently checked by tolerance tightening."""
    from scipy.integrate import solve_ivp
    base = solve_ivp(
        vanderpol_rhs, (t0, t1), y0, method="Radau",
        rtol=1e-10, atol=1e-12, dense_output=True
    )
    tight = solve_ivp(
        vanderpol_rhs, (t0, t1), y0, method="Radau",
        rtol=1e-12, atol=1e-14, dense_output=True
    )
    check_times = np.linspace(t0, t1, 1001)
    discrepancy = np.max(np.abs(base.sol(check_times) - tight.sol(check_times)))
    if not (base.success and tight.success and discrepancy < 1e-7):
        raise RuntimeError(
            "Radau reference failed its tightened-tolerance check: "
            f"success=({base.success}, {tight.success}), discrepancy={discrepancy:.3e}"
        )
    return tight, discrepancy


def main():
    y0 = np.array([2.0, 0.0])
    t0, t1 = 0.0, 20.0

    # ---- Part 1: one blow-up run vs reference --------------------------
    h_bad = 0.1
    with np.errstate(over="ignore", invalid="ignore"):
        t, y = solve_euler(vanderpol_rhs, y0, t0, t1, h_bad)
    sol, reference_discrepancy = reference_solution(y0, t0, t1)
    t_ref = np.linspace(t0, t1, 4000)
    y_ref = sol.sol(t_ref)

    fig, ax = plt.subplots(figsize=(9, 4))
    ax.plot(t_ref, y_ref[0], "k-", lw=1.5,
            label="reference (Radau, tightened tolerances)")
    ax.plot(t, y[:, 0], "r-", lw=1.0, label=f"explicit Euler, h={h_bad}")
    ax.set_xlabel("t"); ax.set_ylabel("y1")
    ax.set_title("Van der Pol (mu=10): explicit Euler blows up while the true\n"
                 "solution stays bounded — the classic stiff failure case")
    ax.legend(); ax.grid(True, ls=":", alpha=0.6)
    fig.tight_layout(); fig.savefig("vanderpol_euler_blowup.png", dpi=150)

    # ---- Part 2: error vs h -------------------------------------------
    h_values = [0.4, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005]
    errs = []
    for h in h_values:
        with np.errstate(over="ignore", invalid="ignore"):
            _, yh = solve_euler(vanderpol_rhs, y0, t0, t1, h)
        errs.append(np.abs(yh[-1] - y_ref[:, -1]).max())

    fig2, ax2 = plt.subplots(figsize=(7, 5))
    ax2.loglog(h_values, errs, "o-", label="explicit Euler error at T=20")
    # reference order-1 line
    h_lin = np.logspace(-2.4, -0.4, 30)
    ax2.loglog(h_lin, 0.05 * h_lin, "k--", label="order-1 reference line")
    ax2.set_xlabel("step size h")
    ax2.set_ylabel("global error")
    ax2.set_title("Van der Pol (mu=10): error does NOT follow order 1 until h is\n"
                  "small enough to enter the stability region — then it drops")
    ax2.legend(); ax2.grid(True, which="both", ls=":", alpha=0.5)
    fig2.tight_layout(); fig2.savefig("vanderpol_h_sweep.png", dpi=150)

    print("Figures written: vanderpol_euler_blowup.png, vanderpol_h_sweep.png")
    print("Radau tolerance-tightening discrepancy:", f"{reference_discrepancy:.3e}")
    finite_values = np.abs(y[:, 0][np.isfinite(y[:, 0])])
    peak_before_failure = np.max(finite_values) if finite_values.size else np.nan
    status = "became non-finite" if not np.all(np.isfinite(y)) else "remained finite"
    print(f"Note for the lecture: Euler with h=0.1 {status}; "
          f"largest finite |y1| before failure = {peak_before_failure:.1e}")


if __name__ == "__main__":
    main()
"""
rk4_skeleton.py - Classical RK4 scaffolding for the ODE IVP project.

Built from euler_skeleton.py per the Lecture-2 checklist: the Euler step is
replaced by the four-stage classical RK4 update, and the expected convergence
order / stability boundary are adapted to RK4.

Run with:
    python rk4_skeleton.py

On success the script prints PASS/FAIL diagnostics and produces
`rk4_logistic.png` and `rk4_convergence.png`.

Authors: Sirui Li, Yuxuan Li, Yuran Zhou, Yazhi Xue
Course: Numerical Analysis of ODEs and PDEs
"""

from pathlib import Path

import numpy as np
import matplotlib.pyplot as plt


# ---------------------------------------------------------------------------
# Model: logistic growth  y' = r y (1 - y/K)   (same as euler_skeleton)
# ---------------------------------------------------------------------------

def logistic_rhs(t, y):
    r = 1.0    # growth rate
    K = 10.0   # carrying capacity
    return r * y * (1.0 - y / K)


# ---------------------------------------------------------------------------
# Classical Runge-Kutta (RK4)
# ---------------------------------------------------------------------------

def rk4_step(f, t, y, h):
    """One classical RK4 step (four function evaluations).

    k1 = f(t, y)
    k2 = f(t + h/2, y + h/2 k1)
    k3 = f(t + h/2, y + h/2 k2)
    k4 = f(t + h,   y + h k3)
    y_{n+1} = y_n + h/6 (k1 + 2 k2 + 2 k3 + k4)
    """
    k1 = f(t, y)
    k2 = f(t + h / 2, y + h / 2 * k1)
    k3 = f(t + h / 2, y + h / 2 * k2)
    k4 = f(t + h, y + h * k3)
    return y + h / 6 * (k1 + 2 * k2 + 2 * k3 + k4)


def solve_rk4(f, y0, t0, t1, h):
    """Integrate f from t0 to t1 with fixed step h using RK4."""
    n_steps = int(np.ceil((t1 - t0) / h))
    t = np.empty(n_steps + 1)
    t[0] = t0
    y = np.zeros((n_steps + 1,) + np.shape(y0))
    y[0] = y0
    for n in range(n_steps):
        step = min(h, t1 - t[n])
        t[n + 1] = t[n] + step
        y[n + 1] = rk4_step(f, t[n], y[n], step)
    return t, y


def logistic_exact(t, y0, r=1.0, K=10.0):
    """Closed-form solution of y' = r y (1 - y/K)."""
    return K / (1 + (K / y0 - 1) * np.exp(-r * t))


# ---------------------------------------------------------------------------
# Convergence study (order 4)
# ---------------------------------------------------------------------------

def convergence_study(f, y0, t0, t1, h_values, exact, plot_path=None):
    h_values = np.asarray(h_values, dtype=float)
    duration = t1 - t0
    ratios = duration / h_values
    if not np.allclose(ratios, np.round(ratios), rtol=0.0, atol=1e-12):
        raise ValueError("For an order study, choose h=(t1-t0)/N with integer N")
    errors = []
    for h in h_values:
        t, y = solve_rk4(f, y0, t0, t1, h)
        err = np.linalg.norm(y[-1] - exact(t[-1]))
        errors.append(err)

    errors = np.asarray(errors)
    slope, intercept = np.polyfit(np.log(h_values), np.log(errors), 1)
    order = slope

    if plot_path is not None:
        fig, ax = plt.subplots(figsize=(6, 4))
        ax.loglog(h_values, errors, "o-", label="classical RK4")

        h_lin = np.logspace(np.log10(h_values.min()), np.log10(h_values.max()), 50)
        c_ref = errors[0] / h_values[0] ** 4.0
        ax.loglog(h_lin, c_ref * h_lin**4.0, "k--", label="order-4 reference")

        if order > 0:
            coef, cov = np.polyfit(np.log(h_values), np.log(errors), 1, cov=True)
            slope_err = np.sqrt(cov[0, 0])
            lx = np.linspace(np.log(h_values.min()), np.log(h_values.max()), 50)
            line = coef[0] * lx + coef[1]
            se = np.sqrt(cov[1, 1] + 2 * lx * cov[0, 1] + lx**2 * cov[0, 0])
            ax.loglog(np.exp(lx), np.exp(line), "r--",
                      label=f"fit {order:.2f} \u00b1 {slope_err:.2f}")
            ax.fill_between(np.exp(lx), np.exp(line - 1.96 * se),
                            np.exp(line + 1.96 * se),
                            color="r", alpha=0.15, label="95% band")

        floor_idx = int(np.argmin(errors))
        if floor_idx < len(h_values) - 1:
            ax.annotate("round-off floor",
                        xy=(h_values[floor_idx], errors[floor_idx]),
                        xytext=(h_values[floor_idx] * 4, errors[floor_idx] * 4),
                        arrowprops=dict(arrowstyle="->"))

        ax.set_xlabel("step size h")
        ax.set_ylabel("global error at T")
        ax.set_title(f"observed order about {order:.2f} (theory: 4.00)")
        ax.grid(True, which="both", ls=":", alpha=0.6)
        ax.legend()
        fig.tight_layout()
        fig.savefig(plot_path, dpi=150)
        plt.close(fig)

    return errors, order


# ---------------------------------------------------------------------------
# Stability experiment: y' = -y with RK4
#
# RK4 stability function R(z) = 1 + z + z^2/2 + z^3/6 + z^4/24.
# On the negative real axis z = -h the boundary |R(-h)| = 1 sits at h ~ 2.785.
# ---------------------------------------------------------------------------

def stability_threshold():
    lam = -1.0
    y0 = np.array([1.0])
    t0, t1 = 0.0, 200.0
    f_linear = lambda t, y: lam * y

    def test_stable(h):
        t, y = solve_rk4(f_linear, y0, t0, t1, h)
        return bool(np.abs(y[-1, 0]) <= 10.0)

    h_inside = 2.5    # just inside  (|R(-2.5)| ~ 0.65 < 1)
    h_outside = 3.0   # just outside (|R(-3.0)| ~ 1.38 > 1)
    assert test_stable(h_inside), f"expected stability at h={h_inside}"
    assert not test_stable(h_outside), f"expected instability at h={h_outside}"
    return h_inside, h_outside


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    print("=" * 60)
    print("rk4_skeleton.py - classical RK4 scaffolding")
    print("=" * 60)

    output_dir = Path(__file__).resolve().parent

    y0 = np.array([0.5])
    t0, t1 = 0.0, 10.0
    h = 0.05

    # 1. sanity run
    t, y = solve_rk4(logistic_rhs, y0, t0, t1, h)
    final = y[-1, 0]
    exact_final = logistic_exact(t[-1], y0[0])
    ok1 = abs(final - exact_final) < 0.2
    print(f"[1] logistic t=10:  rk4={final:.8f}  exact={exact_final:.8f}  "
          f"|err|={abs(final - exact_final):.3e}  -> {'PASS' if ok1 else 'FAIL'}")

    # 2. convergence (order 4)
    h_values = [0.2, 0.1, 0.05, 0.025, 0.0125]
    errors, order = convergence_study(
        logistic_rhs, y0, t0, t1, h_values,
        lambda tt: logistic_exact(tt, y0[0]),
        plot_path=output_dir / "rk4_convergence.png",
    )
    ok2 = 3.5 <= order <= 4.5
    print(f"[2] observed order = {order:.2f}  (theory 4.00) -> {'PASS' if ok2 else 'FAIL'}")

    print("  Your error table (global error at t=10, each h):")
    print(f"  {'h':>8} {'error':>14}")
    for hh, e in zip(h_values, errors):
        print(f"  {hh:>8.4f} {e:>14.6e}")

    # 3. stability threshold (RK4 boundary ~ 2.785)
    h_in, h_out = stability_threshold()
    ok3 = True
    print(f"[3] stable at h={h_in}, unstable at h={h_out} (theory: boundary h~2.785) -> "
          f"{'PASS' if ok3 else 'FAIL'}")

    # 4. trajectory figure
    fig, ax = plt.subplots(figsize=(7, 4))
    ax.plot(t, y[:, 0], label="classical RK4 (h=0.05)")
    ax.plot(t, logistic_exact(t, y0[0]), "k--", label="exact")
    ax.set_xlabel("t"); ax.set_ylabel("y")
    ax.set_title("Logistic growth")
    ax.legend(); ax.grid(True, ls=":", alpha=0.6)
    fig.tight_layout(); fig.savefig(output_dir / "rk4_logistic.png", dpi=150); plt.close(fig)

    print("=" * 60)
    all_ok = ok1 and ok2 and ok3
    print("ALL TESTS PASS" if all_ok else "SOME TESTS FAIL - see above")
    print("=" * 60)


if __name__ == "__main__":
    main()

"""
rk4_stability_region.py — Plot the absolute-stability region of Runge-Kutta
methods (Euler, RK4, implicit Euler) as filled contours.

This script plots the three method regions and overlays eigenvalues of the
Robertson Jacobian at t=40, scaled by a practically relevant step size. The
core idea is:

    The stability region of a one-step method applied to y' = lambda y with
    z = h lambda is the set of z where |R(z)| <= 1, where R is the stability
    function of the method.

    Euler:          R(z) = 1 + z
    RK4:            R(z) = 1 + z + z^2/2 + z^3/6 + z^4/24
    Implicit Euler: R(z) = 1 / (1 - z)

Run with:
    python rk4_stability_region.py

Output: `stability_regions.png` — the three regions overlaid on the complex
z-plane. Use this figure in your report's stability section.

The helper `plot_system_eigenvalues(ax, J, h)` computes h * eig(J) and
scatters it on each region. Treat the overlay as a local frozen-Jacobian
diagnostic, not a sufficient stability proof for a nonlinear, time-varying,
or non-normal system. The separate step sweep verifies its prediction.

Authors: Sirui Li, Yuxuan Li, Yuran Zhou, Yazhi Xue
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp


Y0 = np.array([1.0, 0.0, 0.0])
T_END = 40.0


def robertson_rhs(t, y):
    """Robertson mass-action model."""
    y1, y2, y3 = y
    return np.array([-0.04 * y1 + 1e4 * y2 * y3,
                     0.04 * y1 - 1e4 * y2 * y3 - 3e7 * y2 * y2,
                     3e7 * y2 * y2])


def robertson_jacobian(y):
    """Analytic Jacobian of the Robertson right-hand side."""
    y1, y2, y3 = y
    return np.array([[-0.04, 1e4 * y3, 1e4 * y2],
                     [0.04, -1e4 * y3 - 6e7 * y2, -1e4 * y2],
                     [0.0, 6e7 * y2, 0.0]])


def R_euler(z):
    """Stability function of explicit Euler."""
    return 1.0 + z


def R_rk4(z):
    """Stability function of the classical Runge-Kutta 4 method."""
    return 1.0 + z + z ** 2 / 2.0 + z ** 3 / 6.0 + z ** 4 / 24.0


def R_implicit_euler(z):
    """Stability function of implicit (backward) Euler."""
    return 1.0 / (1.0 - z)


def stability_region(R, z_grid):
    """Boolean mask where |R(z)| <= 1."""
    return np.abs(R(z_grid)) <= 1.0


def plot_system_eigenvalues(ax, J, h, color="tab:orange",
                            label=r"Robertson $h\lambda$ at $t=40$"):
    """Overlay h * eig(J) on one stability region.

    Parameters
    ----------
    ax : matplotlib Axes
        One of the three stability-region subplots.
    J : ndarray, shape (d, d)
        The Jacobian of YOUR system, evaluated at the operating point.
        A scalar is accepted and treated as a 1x1 matrix.
    h : float
        The step size you plan to use.

    The plotted points are the eigenvalues of J scaled by h: z = h lambda.
    If any point falls OUTSIDE a method's region, that method should be
    unstable at this h --- predict it, then verify by running the solver.
    """
    lam = np.linalg.eigvals(np.atleast_2d(J))
    pts = h * lam
    ax.scatter(pts.real, pts.imag, s=70, marker="x", color=color,
               label=label, zorder=5)


def main():
    # grid in the complex plane: z = x + i y
    x = np.linspace(-4.0, 3.0, 1200)
    y = np.linspace(-4.0, 4.0, 1200)
    X, Y = np.meshgrid(x, y)
    Z = X + 1j * Y

    region_euler = stability_region(R_euler, Z)
    region_rk4 = stability_region(R_rk4, Z)
    region_ie = stability_region(R_implicit_euler, Z)

    fig, axes = plt.subplots(1, 3, figsize=(13, 4.2))

    for ax, (name, region, color) in zip(
        axes,
        [
            ("Explicit Euler", region_euler, "tab:blue"),
            ("RK4", region_rk4, "tab:green"),
            ("Implicit Euler", region_ie, "tab:red"),
        ],
    ):
        ax.contourf(X, Y, region, levels=[0.5, 1.5], colors=[color], alpha=0.35)
        ax.contour(X, Y, region, levels=[0.5], colors=[color], linewidths=1.2)
        # axis and labels
        ax.axhline(0, color="k", lw=0.6)
        ax.axvline(0, color="k", lw=0.6)
        ax.set_xlim(-4, 3)
        ax.set_ylim(-4, 4)
        ax.set_xlabel("Re(z)")
        ax.set_ylabel("Im(z)")
        ax.set_title(name)
        ax.set_aspect("equal")
        ax.grid(True, ls=":", alpha=0.4)

    # Robertson overlay.  h=8.2e-4 is close to the empirical RK4 stability
    # boundary.  At t=40 the fastest mode is approximately -3.39e3, so its
    # scaled value is near -2.78: outside Euler's disc, near RK4's boundary,
    # and inside implicit Euler's left-half-plane region.
    ref = solve_ivp(robertson_rhs, (0.0, T_END), Y0, method="Radau",
                    rtol=1e-12, atol=1e-14, t_eval=[T_END])
    if not ref.success:
        raise RuntimeError("Radau reference solve failed")
    J_robertson = robertson_jacobian(ref.y[:, -1])
    h_overlay = 8.2e-4
    eigvals = np.linalg.eigvals(J_robertson)
    print("Robertson eigenvalues at t=40:", eigvals)
    print("scaled values h*lambda for h=8.2e-4:", h_overlay * eigvals)
    for ax in axes:
        plot_system_eigenvalues(ax, J_robertson, h_overlay)
    axes[0].legend(loc="upper left")

    fig.suptitle(
        "Absolute-stability regions with Robertson overlay "
        r"($t=40$, $h=8.2\times10^{-4}$)",
        fontsize=13,
    )
    fig.tight_layout()
    fig.savefig("stability_regions.png", dpi=150)
    plt.show()

"""
robertson_cost_matched.py - Cost versus accuracy at a MATCHED accuracy target.

Project Brief, Section 2, item 5 ("Cost versus accuracy", learning outcome D)
requires all four of the following, and this script supplies each of them:

  1. Name the cost measure BEFORE quoting any number.
     Primary measure : right-hand-side (RHS) evaluations.
     Secondary       : wall-clock seconds (best of two runs, same machine,
                       same process, single-threaded numpy).
  2. Compare at a matched accuracy target: every method is brought to the same
     error against our own high-accuracy reference solution, not run at
     whatever step size happens to look good.
  3. State what is NOT counted and hold it constant:
       - not counted in the RHS count : Jacobian assembly and the 3x3 LU
         factorisation of (I - h J). These are counted separately below
         (jac_asm, lin_solves) so a reader who disagrees with RHS-weighted
         counting can re-weight our numbers instead of trusting them.
       - not counted at all and identical for every method: reference-solution
         construction, figure production, interpreter start-up. There is no
         compilation step. The reference solution is built once and excluded
         from every timing.
  4. Report the result even where it contradicts the expected winner.

Error norms. Two are reported, because they disagree:
    endpoint    : ||y_h(40) - y_ref(40)||_inf        (what our report quotes)
    trajectory  : max_t ||y_h(t) - y_ref(t)||_inf    (stricter; the transient
                  error is larger than the endpoint error)
Both are computed against the same reference. The trajectory norm for the
Euler methods uses linear interpolation of the fixed-step solution onto the
reference grid; that interpolation error is orders of magnitude below every
error we report for them.

Run:  python robertson_cost_matched.py
Outputs: cost_matched.png, cost_matched.csv
"""

import csv
import os
import time

import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

Y0 = np.array([1.0, 0.0, 0.0])
T_END = 40.0
BLOWUP = 1e12
NEWTON_TOL = 1e-10
NEWTON_MAXIT = 30
REPEATS = 2

# The LOOSE target is not a free parameter: it is defined as the error of
# explicit Euler at the largest step size that is still stable. That is the
# honest way to ask "can anything beat explicit Euler at its own best stable
# operating point?", and it avoids the trap of picking a target that happens to
# sit right on the stability cliff, where explicit Euler's error is dominated
# by marginal-stability amplification rather than by its truncation error.
TARGET_STRICT = 1.0e-5

H_EXPLICIT = [1e-3, 8e-4, 6e-4, 5e-4, 4e-4, 3e-4]
H_RK4 = [2e-3, 1e-3, 8.5e-4, 8.2e-4, 8.0e-4, 5e-4]
H_IMPLICIT = [2.0, 1.0, 0.8, 0.7, 0.6, 0.5, 0.4, 0.2, 0.1, 0.05, 0.02, 0.01,
              0.005, 0.003, 0.002, 0.001]


# --------------------------------------------------------------------------
# model
# --------------------------------------------------------------------------

def rhs(t, y):
    y1, y2, y3 = y
    return np.array([-0.04 * y1 + 1e4 * y2 * y3,
                     0.04 * y1 - 1e4 * y2 * y3 - 3e7 * y2 * y2,
                     3e7 * y2 * y2])


def jacobian(t, y):
    y1, y2, y3 = y
    return np.array([[-0.04, 1e4 * y3, 1e4 * y2],
                     [0.04, -1e4 * y3 - 6e7 * y2, -1e4 * y2],
                     [0.0, 6e7 * y2, 0.0]])


# --------------------------------------------------------------------------
# integrators, each returning (ok, y_end, t_grid, y_grid, work)
# --------------------------------------------------------------------------

def run_explicit_euler(h):
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    ts = np.empty(n + 1)
    ys = np.empty((n + 1, 3))
    ts[0], ys[0] = 0.0, y
    for k in range(n):
        s = min(h, T_END - t)
        y = y + s * rhs(t, y)
        t += s
        if not np.all(np.isfinite(y)) or np.max(np.abs(y)) > BLOWUP:
            return False, None, None, None, {"rhs": 0, "steps": 0,
                                             "jac_asm": 0, "lin_solves": 0,
                                             "newton_iters": 0, "rejected": 0}
        ts[k + 1], ys[k + 1] = t, y
    return True, y, ts, ys, {"rhs": n, "steps": n, "jac_asm": 0,
                             "lin_solves": 0, "newton_iters": 0, "rejected": 0}


def run_rk4(h):
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    ts = np.empty(n + 1)
    ys = np.empty((n + 1, 3))
    ts[0], ys[0] = 0.0, y
    for k in range(n):
        s = min(h, T_END - t)
        k1 = rhs(t, y)
        k2 = rhs(t + 0.5 * s, y + 0.5 * s * k1)
        k3 = rhs(t + 0.5 * s, y + 0.5 * s * k2)
        k4 = rhs(t + s, y + s * k3)
        y = y + (s / 6.0) * (k1 + 2 * k2 + 2 * k3 + k4)
        t += s
        if not np.all(np.isfinite(y)) or np.max(np.abs(y)) > BLOWUP:
            return False, None, None, None, {"rhs": 0, "steps": 0,
                                             "jac_asm": 0, "lin_solves": 0,
                                             "newton_iters": 0, "rejected": 0}
        ts[k + 1], ys[k + 1] = t, y
    return True, y, ts, ys, {"rhs": 4 * n, "steps": n, "jac_asm": 0,
                             "lin_solves": 0, "newton_iters": 0, "rejected": 0}


def run_implicit_euler(h, tol=NEWTON_TOL):
    n = int(np.ceil(T_END / h))
    t = 0.0
    y = Y0.copy()
    ts = np.empty(n + 1)
    ys = np.empty((n + 1, 3))
    ts[0], ys[0] = 0.0, y
    newton_iters = 0
    jac_asm = 0
    lin_solves = 0
    for k in range(n):
        s = min(h, T_END - t)
        tn = t + s
        w = y.copy()
        converged = False
        for _ in range(NEWTON_MAXIT):
            F = w - y - s * rhs(tn, w)
            newton_iters += 1                       # one RHS-style evaluation
            if np.linalg.norm(F, np.inf) < tol:     # convergence check: no solve
                converged = True
                break
            JF = np.eye(3) - s * jacobian(tn, w)    # Jacobian assembly
            jac_asm += 1
            w = w - np.linalg.solve(JF, F)          # 3x3 LU factorise + solve
            lin_solves += 1
        if not converged:
            return False, None, None, None, {"rhs": 0, "steps": 0, "jac_asm": 0,
                                             "lin_solves": 0,
                                             "newton_iters": 0, "rejected": 0}
        y = w
        t = tn
        if not np.all(np.isfinite(y)) or np.max(np.abs(y)) > BLOWUP:
            return False, None, None, None, {"rhs": 0, "steps": 0, "jac_asm": 0,
                                             "lin_solves": 0,
                                             "newton_iters": 0, "rejected": 0}
        ts[k + 1], ys[k + 1] = t, y
    # Every evaluation of F at line 149 contains exactly one rhs(tn, w)
    # evaluation, including the final successful convergence check.  Therefore
    # newton_iters is already the complete RHS count; adding one more check per
    # time step would double-count that final evaluation.
    work = {"rhs": newton_iters,
            "steps": n, "jac_asm": jac_asm, "lin_solves": lin_solves,
            "newton_iters": newton_iters, "rejected": 0}
    return True, y, ts, ys, work


# --------------------------------------------------------------------------
# harness: measure one (method, h) run
# --------------------------------------------------------------------------

def measure(name, fn, h, ref_t, ref_y):
    t0 = time.perf_counter()
    ok, y_end, ts, ys, work = fn(h)
    elapsed = time.perf_counter() - t0
    if not ok:
        return {"method": name, "h": h, "ok": False, "wall": elapsed}
    for _ in range(REPEATS - 1):
        t1 = time.perf_counter()
        fn(h)
        elapsed = min(elapsed, time.perf_counter() - t1)
    err_end = float(np.max(np.abs(y_end - ref_y[:, -1])))
    interp = np.column_stack([np.interp(ref_t, ts, ys[:, j]) for j in range(3)])
    err_traj = float(np.max(np.abs(interp - ref_y.T)))
    d = {"method": name, "h": h, "ok": True, "steps": work["steps"],
         "rhs": work["rhs"], "jac_asm": work["jac_asm"],
         "lin_solves": work["lin_solves"],
         "newton_iters": work["newton_iters"],
         "err_end": err_end, "err_traj": err_traj, "wall": elapsed}
    return d


def cheapest(rows, target, key="err_end"):
    """Fewest RHS evaluations among the runs that meet the target (largest h)."""
    ok = [r for r in rows if r.get("ok") and r[key] <= target]
    if not ok:
        return None
    return min(ok, key=lambda r: r["rhs"])


def main():
    print("=" * 78)
    print("robertson_cost_matched.py - cost versus accuracy at a matched target")
    print("cost measure: RHS evaluations (primary), wall-clock seconds (secondary)")
    print("=" * 78)

    ref_t = np.concatenate([np.logspace(-8, -1, 3000), np.linspace(0.1, T_END, 3000)])
    baseline = solve_ivp(rhs, (0.0, T_END), Y0, method="Radau", rtol=1e-10,
                         atol=1e-12, dense_output=True)
    ref = solve_ivp(rhs, (0.0, T_END), Y0, method="Radau", rtol=1e-12,
                    atol=1e-14, dense_output=True)
    bdf = solve_ivp(rhs, (0.0, T_END), Y0, method="BDF", rtol=1e-12,
                    atol=1e-14)
    ref_y = ref.sol(ref_t)
    tighten_diff = float(np.max(np.abs(ref_y - baseline.sol(ref_t))))
    method_diff = float(np.max(np.abs(ref.y[:, -1] - bdf.y[:, -1])))
    print(f"\nreference (Radau, rtol=1e-12, atol=1e-14): y(40) = {ref.y[:, -1]}")
    print(f"  100x tolerance-tightening check (Radau): {tighten_diff:.3e}")
    print(f"  independent-method check (Radau vs BDF at t=40): {method_diff:.3e}")

    # ---- eigenvalues along the reference trajectory -----------------------
    lam_max, t_at = 0.0, 0.0
    for t, y in zip(ref_t, ref_y.T):
        m = float(np.max(np.abs(np.linalg.eigvals(jacobian(t, y)))))
        if m > lam_max:
            lam_max, t_at = m, t
    b_euler = 2.0 / lam_max
    b_rk4 = 2.785 / lam_max
    print(f"max |lambda| along trajectory = {lam_max:.4e} at t = {t_at:.2f}")
    print(f"  frozen-Jacobian prediction, explicit Euler : h < {b_euler:.3e}")
    print(f"  frozen-Jacobian prediction, RK4            : h < {b_rk4:.3e}")

    rows = []
    print(f"\n  {'method':<10} {'h':>9} {'err_end':>11} {'err_traj':>11} "
          f"{'steps':>10} {'RHS':>11} {'jac':>9} {'solve':>9} {'wall/s':>8}")
    print("  " + "-" * 92)
    for h in H_EXPLICIT:
        r = measure("explicit", run_explicit_euler, h, ref_t, ref_y)
        rows.append(r)
        print("  {:<10} {:>9.1e} {:>11.3e} {:>11.3e} {:>10,} {:>11,} "
              "{:>9} {:>9} {:>8.2f}".format(
                  r["method"], r["h"], r["err_end"], r["err_traj"], r["steps"],
                  r["rhs"], r["jac_asm"], r["lin_solves"], r["wall"])
              if r["ok"] else
              f"  {'explicit':<10} {h:>9.1e}   UNSTABLE")
    for h in H_RK4:
        r = measure("rk4", run_rk4, h, ref_t, ref_y)
        rows.append(r)
        print("  {:<10} {:>9.1e} {:>11.3e} {:>11.3e} {:>10,} {:>11,} "
              "{:>9} {:>9} {:>8.2f}".format(
                  r["method"], r["h"], r["err_end"], r["err_traj"], r["steps"],
                  r["rhs"], r["jac_asm"], r["lin_solves"], r["wall"])
              if r["ok"] else
              f"  {'rk4':<10} {h:>9.1e}   UNSTABLE")
    for h in H_IMPLICIT:
        r = measure("implicit", lambda hh: run_implicit_euler(hh), h, ref_t, ref_y)
        rows.append(r)
        print("  {:<10} {:>9.1e} {:>11.3e} {:>11.3e} {:>10,} {:>11,} "
              "{:>9,} {:>9,} {:>8.2f}".format(
                  r["method"], r["h"], r["err_end"], r["err_traj"], r["steps"],
                  r["rhs"], r["jac_asm"], r["lin_solves"], r["wall"])
              if r["ok"] else
              f"  {'implicit':<10} {h:>9.1e}   NEWTON FAILED")

    # ---- empirical stability boundary -------------------------------------
    def boundary_check(name, bound):
        ok = sorted([r for r in rows if r["method"] == name and r["ok"]],
                    key=lambda r: r["h"])
        bad = sorted([r["h"] for r in rows
                      if r["method"] == name and not r["ok"]])
        if len(ok) < 2:
            return
        # marginal-stability amplification shows up as a jump in the error as h
        # approaches the bound, not as a gradual loss of order
        onset, ratio, h_acc = None, None, None
